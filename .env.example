# 복사해서 사용:  cp .env.example .env   (.env는 Git에 올리지 않습니다)

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---------- PostgreSQL ----------
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
# 로컬(비 Docker) 실행용. Compose에서는 postgres 서비스로 자동 지정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Redis·Celery (로컬 실행용. Compose에서는 redis 서비스로 자동 지정) ----------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------- AI 서버 (로컬 실행용. Compose에서는 http://fastapi:8001) ----------
FASTAPI_URL=http://localhost:8001
FASTAPI_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=100
UNCERTAIN_THRESHOLD=0.4

# ---------- IP Webcam ----------
# 허용 카메라 목록 "이름=주소" (쉼표로 여러 개). 사용자는 화면에서 '이름'만 고릅니다.
# 휴대폰 IP Webcam 앱 주소 예: http://<휴대폰 IP>:8080/video
ALLOWED_CAMERAS=phone1=http://192.168.0.XX:8080/video
CAMERA_CAPTURE_SECONDS=8
CAMERA_OPEN_TIMEOUT_SECONDS=10
